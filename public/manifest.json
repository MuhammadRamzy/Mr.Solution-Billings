{
  "name": "MyBilling",
  "short_name": "MyBilling",
  "description": "Billing, invoicing, quotes, and expense tracking for freelance businesses",
  "start_url": "/dashboard",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/logo_with_bg.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/logo_with_bg.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Invoice",
      "short_name": "Invoice",
      "description": "Create a new invoice",
      "url": "/invoices/new",
      "icons": [{ "src": "/logo_with_bg.png", "sizes": "192x192" }]
    },
    {
      "name": "New Quote",
      "short_name": "Quote",
      "description": "Create a new quote",
      "url": "/invoices/new?type=quote",
      "icons": [{ "src": "/logo_with_bg.png", "sizes": "192x192" }]
    },
    {
      "name": "Add Expense",
      "short_name": "Expense",
      "description": "Record a new expense",
      "url": "/expenses",
      "icons": [{ "src": "/logo_with_bg.png", "sizes": "192x192" }]
    }
  ]
}
